# Copy this file to .env.local for local development.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# MongoDB (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/momo_delights
MONGODB_DB=momo_delights

# Admin access is granted only to the registered account with this email.
ADMIN_EMAIL=

# Optional: enable only for a one-time database connection/index check.
INIT_DB=false
INIT_DB_TOKEN=temporary-random-token
